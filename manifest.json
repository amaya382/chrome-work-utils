{
  "manifest_version": 3,
  "name": "Development Utils",
  "version": "0.1.0",
  "description": "Color pages by environment, such as the project or account open in a cloud console",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Development Utils settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "content.js"]
    }
  ]
}
