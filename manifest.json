{
  "manifest_version": 3,
  "name": "Development Utils",
  "version": "0.1.0",
  "description": "Developer utilities for Chrome: color pages by environment, draw on pages, and highlight text",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus"],
  "action": {
    "default_title": "Development Utils",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-drawing": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Draw on the page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "content.js"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["annotation.js", "draw.js"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["annotation.js", "highlight.js"]
    }
  ]
}
